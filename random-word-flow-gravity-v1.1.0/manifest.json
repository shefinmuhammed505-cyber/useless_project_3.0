{
  "manifest_version": 3,
  "name": "Random Word Flow",
  "version": "1.2.0",
  "description": "A steady horizontal gravity flow for text, images, and page content.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "style.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}